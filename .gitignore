# Build products
.build/
DerivedData/
*.o
*.dSYM/
dist/
TouchBarUsage.app/

# Xcode / SwiftPM local state
.swiftpm/
*.xcuserstate
xcuserdata/
Package.resolved

# Local branded assets (see docs/branding.md) — never commit third-party artwork
LocalAssets/

# Clawd pose data generated by `make assets`. Clawd is Anthropic's character and
# the upstream pose library publishes no licence, so this repository must never
# redistribute it — only the script that fetches it locally is tracked.
GeneratedAssets/
*clawd-poses.json
clawd_presets.h

# Download / mascot source caches
.asset-cache/
*.clawd-src

# Composed tray badge built from third-party marks. The repository ships only
# the original drawn fallback badge; anything composed from Clawd or the Codex
# blossom is local to the developer's machine.
combined-tray-badge.*
GeneratedAssets/CombinedBadge/

# Development preview renders
PreviewOutput/

# Local secrets / captured fixtures from real accounts
*.local
.env
Fixtures/local-*
*-real-response.json

# macOS
.DS_Store
